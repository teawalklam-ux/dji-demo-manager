SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key
NAS_ARCHIVE_TOKEN=replace-with-random-32-byte-token

ARCHIVE_ROOT=/archive
STATE_DB=/data/archive.db
ARCHIVE_HOST_PATH=/volume1/docker/dji-return-photo-archive/archive
STATE_HOST_PATH=/volume1/docker/dji-return-photo-archive/data
CERTS_HOST_PATH=/volume1/docker/dji-return-photo-archive/certs
PUID=1000
PGID=1000

WORKER_ID=archive-worker
POLL_SECONDS=60
CLAIM_LIMIT=5
MAX_FILE_BYTES=6291456
LOG_LEVEL=INFO

ALLOWED_ORIGIN=https://your-account.github.io
VIEW_BIND=0.0.0.0
VIEW_BIND_ADDRESS=127.0.0.1
VIEW_PORT=8787

# Direct TLS: mount fullchain.pem and privkey.pem, then keep REQUIRE_TLS=true.
# If UGOS reverse proxy terminates HTTPS in front of port 8787, leave these
# blank and set REQUIRE_TLS=false. The public LAN URL configured in Supabase
# must still use https:// so browsers do not block mixed content.
REQUIRE_TLS=true
TLS_CERT_FILE=/certs/fullchain.pem
TLS_KEY_FILE=/certs/privkey.pem
